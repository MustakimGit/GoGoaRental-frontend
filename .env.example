# Non-secret frontend settings only. Copy to .env.local for local overrides.
# Never put API secrets (e.g. Razorpay key secret) here - everything prefixed VITE_ ships to the browser.

# Backend URL the Vite dev server proxies /api and /hubs to.
VITE_DEV_API_PROXY_TARGET=http://localhost:5080

# Base path for API calls from the browser (same-origin via proxy in dev).
VITE_API_BASE_URL=/api
